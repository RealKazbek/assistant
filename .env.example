TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
OWNER_TELEGRAM_ID=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DATABASE_PATH=./data/bot.sqlite3
MAX_HISTORY_MESSAGES=12
MAX_OUTPUT_TOKENS=400
RATE_LIMIT_MESSAGES=8
RATE_LIMIT_WINDOW_SECONDS=60
HUMAN_TAKEOVER_MINUTES=60
GLOBAL_PAUSE_MINUTES=60
MIN_REPLY_DELAY_SECONDS=4
MAX_REPLY_DELAY_SECONDS=6
RECENT_MESSAGE_LIMIT=6
SUMMARY_TRIGGER_NEW_MESSAGES=8
MAX_KNOWLEDGE_CARDS=4
MAX_KNOWLEDGE_CHARS=3000
MAX_MEMORY_SUMMARY_CHARS=2000
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=00:00
APP_TIMEZONE=Asia/Almaty
INITIAL_REPLY_DEBOUNCE_SECONDS=30
ACTIVE_REPLY_DEBOUNCE_SECONDS=5
CONVERSATION_IDLE_RESET_MINUTES=60
LOG_LEVEL=INFO
